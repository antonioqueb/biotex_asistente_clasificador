<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- El modal base más el campo Marca (debajo del nombre) y el texto del encabezado. -->
    <t t-name="biotex_asistente_clasificador.LineEditorDialog" t-inherit="biotex_catalog.LineEditorDialog" t-inherit-mode="primary">
        <xpath expr="//h4[@class='o_bcw_modal_title']" position="replace">
            <h4 class="o_bcw_modal_title o_bac_editor_title" t-att-class="{o_bac_editor_title_new: isNewProduct}">
                <t t-if="isNewProduct">
                    <i class="fa fa-plus-circle" aria-hidden="true"/>Nuevo producto
                    <span class="o_bcw_chip o_bac_new_badge">NUEVO</span>
                </t>
                <t t-else="">
                    <i class="fa fa-pencil-square-o" aria-hidden="true"/>Editando Producto: <span class="o_bcw_modal_product" t-esc="productTitle"/>
                </t>
            </h4>
        </xpath>
        <xpath expr="//div[@class='o_bcw_modal_ref']" position="attributes">
            <attribute name="t-att-aria-label">line.classified ? 'Referencia final' : 'Referencia pendiente'</attribute>
        </xpath>
        <xpath expr="//div[@class='o_bcw_modal_ref']/small" position="replace">
            <small class="o_bcw_help">
                <t t-if="line.classified">Referencia final: el folio se reservó al confirmar la marca.</t>
                <t t-else="">Referencia pendiente: el folio se reserva al confirmar la marca.</t>
            </small>
        </xpath>
        <xpath expr="//textarea[@id='bcw_editor_name']/.." position="after">
            <div class="o_bcw_field o_bac_brand" aria-label="Marca del producto">
                <label class="o_bcw_label" for="bac_editor_brand">Marca <span class="o_bcw_req">*</span></label>

                <div class="o_bac_brand_current" t-if="brandConfirmedId">
                    <span class="o_bcw_chip o_bcw_chip_ok"><i class="fa fa-check" aria-hidden="true"/> <t t-esc="brandConfirmedLabel"/></span>
                    <span t-if="line.classified" class="o_bcw_mono o_bac_brand_folio">folio <t t-esc="line.folio"/></span>
                </div>

                <div t-if="rootMismatch" class="o_bac_root_warn" role="alert">
                    <i class="fa fa-exclamation-triangle" aria-hidden="true"/>
                    <div class="o_bac_root_warn_text">
                        <strong>La raíz de clasificación cambió; se debe reservar un folio nuevo.</strong>
                        <span>El folio <span class="o_bcw_mono" t-esc="line.folio"/> se reservó para <span class="o_bcw_mono" t-esc="line.product_root"/>
                            y esta sesión clasifica en <span class="o_bcw_mono" t-esc="line.session_root"/>. No se puede guardar con una referencia
                            inconsistente: usa «Cambiar marca y reservar folio» (misma marca, folio nuevo en <span class="o_bcw_mono" t-esc="rootTargetPrefix"/>).</span>
                    </div>
                </div>
                <div class="o_bac_brand_row">
                    <div class="o_bac_brand_input">
                        <span t-if="brandPendingId and brandPendingId !== brandConfirmedId" class="o_bcw_chip o_bac_chip_pending">
                            <i class="fa fa-bookmark-o" aria-hidden="true"/>
                            <span t-esc="state.brand.pendingLabel"/>
                            <button t-if="!props.readonly" type="button" class="o_bcw_chip_x" aria-label="Quitar marca elegida" t-on-click="clearPendingBrand"><i class="fa fa-times"/></button>
                        </span>
                        <input t-else="" id="bac_editor_brand" type="text" class="o_bcw_input" autocomplete="off"
                               t-att-placeholder="brandConfirmedId ? 'Cambiar de marca: buscar o crear...' : 'Buscar o crear marca...'"
                               t-att-readonly="props.readonly" t-att-value="state.brand.query"
                               t-on-focus="openBrands" t-on-input="onBrandQuery" t-on-blur="closeBrands" t-on-keydown="onBrandKeydown"/>
                        <div class="o_bcw_lookup o_bac_brand_lookup" t-if="state.brand.open and (state.brand.options.length or canCreateBrand or state.brand.loading)">
                            <div t-if="state.brand.loading" class="o_bcw_lookup_item o_bcw_muted"><i class="fa fa-refresh fa-spin me-1"/>Leyendo el catálogo de marcas...</div>
                            <button t-foreach="state.brand.options" t-as="b" t-key="b.id" type="button" class="o_bcw_lookup_item"
                                    t-on-pointerdown.prevent="noop" t-on-click="() => this.pickBrand(b)">
                                <span class="o_bcw_mono o_bac_brand_code" t-esc="b.code"/> <span t-esc="b.name"/>
                                <small t-if="b.used" class="o_bcw_muted ms-1">· ya usada en este clasificador</small>
                            </button>
                            <button t-if="canCreateBrand and !state.brand.loading" type="button" class="o_bcw_lookup_item o_bac_brand_create"
                                    t-on-pointerdown.prevent="noop" t-on-click="createBrand">
                                <i class="fa fa-plus me-1" aria-hidden="true"/>Crear marca «<t t-esc="state.brand.query.trim()"/>»
                            </button>
                        </div>
                    </div>
                    <button t-if="!props.readonly" type="button" class="btn btn-primary btn-sm o_bac_brand_confirm"
                            t-att-class="{ 'btn-warning': rootMismatch and !(brandPendingId and brandPendingId !== brandConfirmedId) }"
                            t-att-disabled="!canReserveFolio"
                            t-on-click="confirmBrand">
                        <i t-att-class="state.brand.confirming ? 'fa fa-circle-o-notch fa-spin' : 'fa fa-key'" aria-hidden="true"/>
                        <t t-esc="brandConfirmedId ? ' Cambiar marca y reservar folio' : ' Confirmar marca y reservar folio'"/>
                    </button>
                </div>

                <small class="o_bcw_help" t-esc="brandHelp"/>
                <small t-if="state.errors.brand_id" class="o_bcw_error" t-esc="state.errors.brand_id"/>
                <small t-if="!brandConfirmedId and brandCatalogLabel" class="o_bcw_help">Marca actual en la ficha: <strong t-esc="brandCatalogLabel"/> (sugerida; confírmala o elige otra).</small>
                <small t-if="line.reclassify_from" class="o_bcw_warn"><i class="fa fa-exclamation-circle me-1" aria-hidden="true"/>Clave actual <span class="o_bcw_mono" t-esc="line.reclassify_from"/>: al generar claves recibirá la nueva y su numeración cambiará.</small>
            </div>
        </xpath>

        <!-- La unidad indivisible deja de ser un campo suelto: es la primera fila fija de "Unidades y empaques". -->
        <xpath expr="//select[@id='bcw_editor_uom']/../.." position="replace"/>

        <!-- Unidad base + empacados en una sola tabla. La fila base es sintética (uom_id de la línea): no es un
             product.uom, no se elimina ni se reordena; su contenido no cambia factores de conversión. -->
        <xpath expr="//section[@aria-label='Empacados de productos y códigos de barras']" position="replace">
            <section class="o_bcw_editor_block o_bac_units" aria-label="Unidades y empaques">
                <div class="o_bcw_editor_heading">
                    <h5>Unidades y empaques</h5>
                    <p>La primera fila indica cuántos elementos contiene una unidad base. Se compra, vende y cuenta como una unidad. Los empacados indican cuántas unidades base contienen.</p>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm o_bcw_rows o_bac_units_table">
                        <thead><tr>
                            <th class="o_bcw_col_type">Tipo de empaque</th>
                            <th>Cantidad de elementos</th>
                            <th>Código de barras</th>
                            <th class="o_bac_units_act"/>
                        </tr></thead>
                        <tbody>
                            <tr class="o_bac_unit_base" t-att-class="{ 'o_bac_unit_base--error': state.errors.uom_id || state.errors.base_unit_quantity }">
                                <td>
                                    <div class="o_bac_unit_base_cell">
                                        <i class="fa fa-key o_bac_unit_key" aria-hidden="true" title="Unidad base del producto"/>
                                        <t t-if="!state.uomEditing">
                                            <span class="o_bac_unit_base_name"><t t-esc="baseUnitLabel"/> · Unidad base</span>
                                            <button t-if="canChangeBaseUom" type="button" class="btn btn-link btn-sm p-0 o_bac_unit_change" t-on-click="startUomEdit">Cambiar unidad</button>
                                        </t>
                                        <t t-else="">
                                            <select id="bcw_editor_uom" class="o_input o_bcw_input o_bac_unit_select" required="required" aria-label="Unidad indivisible"
                                                    t-att-aria-invalid="!!state.errors.uom_id" t-att-class="{ 'o_bcw_input--error': state.errors.uom_id }"
                                                    t-att-disabled="!canChangeBaseUom" t-on-change="onBaseUomChange" autofocus="autofocus">
                                                <option value="" t-att-selected="!state.draft.uom_id">—</option>
                                                <option t-foreach="state.catalogs.uoms" t-as="uom" t-key="uom.id" t-att-value="uom.id"
                                                        t-att-selected="uom.id === state.draft.uom_id" t-esc="uom.name"/>
                                            </select>
                                            <button type="button" class="btn btn-link btn-sm p-0 o_bac_unit_change" t-on-click="cancelUomEdit">Listo</button>
                                        </t>
                                    </div>
                                    <small t-if="state.line.uom_locked" class="o_bcw_help d-block"><i class="fa fa-lock me-1" aria-hidden="true"/>El producto ya tiene movimientos de inventario en <strong t-esc="state.line.product_uom_name"/>: esa unidad se conserva. Registra cajas, bolsas u otros empaques como empacados con su equivalencia.</small>
                                    <small t-elif="!state.uomEditing" class="o_bcw_help d-block">Una misma unidad para comprar, vender y contar, cualquiera que sea su contenido.</small>
                                    <small t-if="state.errors.uom_id" class="o_bcw_error d-block" t-esc="state.errors.uom_id"/>
                                    <div class="o_bac_unit_description">
                                        <label for="bac_base_unit_description">Descripción de la unidad</label>
                                        <input id="bac_base_unit_description" class="o_bcw_input" t-att-value="baseUnitDescription" readonly="readonly" aria-live="polite"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="o_bcw_qty_unit">
                                        <input aria-label="Cantidad de elementos de la unidad base" class="o_bcw_input" type="number" min="0" step="any" required="required"
                                               t-att-value="baseUnitQuantity" t-att-readonly="props.readonly" t-att-aria-invalid="!!state.errors.base_unit_quantity"
                                               t-att-class="{ 'o_bcw_input--error': state.errors.base_unit_quantity }" t-on-input="(ev) => this.onNumber('base_unit_quantity', ev)"/>
                                        <span class="o_bcw_qty_unit_label">elementos</span>
                                    </div>
                                    <small t-if="state.errors.base_unit_quantity" class="o_bcw_error d-block" t-esc="state.errors.base_unit_quantity"/>
                                </td>
                                <td><input aria-label="Código de barras de la unidad base" class="o_bcw_input o_bcw_mono o_bac_unit_barcode" placeholder="Código de barras de la pieza"
                                           t-att-value="state.draft.barcode" t-att-readonly="props.readonly" t-on-input="(ev) => this.onInput('barcode', ev)"/></td>
                                <td class="o_bac_units_act"/>
                            </tr>
                            <tr t-foreach="state.draft.presentation_data" t-as="row" t-key="row_index" class="o_bac_unit_pack">
                                <td>
                                    <select aria-label="Tipo de empaque" class="o_bcw_input" t-att-disabled="props.readonly" t-on-change="(ev) => this.onRow('presentation_data', row_index, 'package_type_id', ev)">
                                        <option value="" t-att-selected="!row.package_type_id" t-esc="rowTypeLabel(row) || '— Elige el tipo —'"/>
                                        <option t-foreach="state.catalogs.package_types" t-as="pt" t-key="pt.id" t-att-value="pt.id"
                                                t-att-selected="pt.id === row.package_type_id" t-esc="pt.name"/>
                                    </select>
                                </td>
                                <td>
                                    <div class="o_bcw_qty_unit">
                                        <input aria-label="Cantidad por empacado" class="o_bcw_input" type="number" min="1" step="1" t-att-value="row.quantity" t-att-readonly="props.readonly" t-on-input="(ev) => this.onRow('presentation_data', row_index, 'quantity', ev)"/>
                                        <span class="o_bcw_qty_unit_label" t-att-title="'Unidad base: ' + baseUnitLabel" t-esc="baseUnitLabel"/>
                                    </div>
                                </td>
                                <td><input aria-label="Código del empacado" class="o_bcw_input o_bcw_mono" t-att-value="row.barcode" t-att-readonly="props.readonly" t-on-input="(ev) => this.onRow('presentation_data', row_index, 'barcode', ev)"/></td>
                                <td class="o_bac_units_act"><button t-if="!props.readonly" type="button" class="btn btn-link" aria-label="Quitar empacado" t-on-click="() => this.removeRow('presentation_data', row_index)"><i class="fa fa-trash"/></button></td>
                            </tr>
                            <tr t-if="!state.draft.presentation_data.length" class="o_bac_unit_empty"><td colspan="4" class="o_bcw_help">Sin empacados: la unidad base se vende y se cuenta por sí sola.</td></tr>
                        </tbody>
                    </table>
                </div>
                <button t-if="!props.readonly" type="button" class="btn btn-outline-secondary btn-sm align-self-start o_bac_add_pack" t-on-click="() => this.addRow('presentation_data')"><i class="fa fa-plus me-1"/>Agregar empacado</button>
                <p t-if="state.errors.presentation_data" class="o_bcw_error" t-esc="state.errors.presentation_data"/>
            </section>
        </xpath>
    </t>

</templates>
